# Where the SQLite database lives
DATABASE_PATH=./data/tracker.db
PORT=3000

# Optional: protect the dashboard with HTTP basic auth (any username, this password)
APP_PASSWORD=

# Timezone used for schedules and for "which day" a snapshot belongs to
TZ=America/New_York

# Cron schedules (node-cron syntax)
FETCH_CRON=0 6 * * *
DIGEST_CRON=0 9 * * 1

# Email digest. SMTP_URL works with any provider, e.g.
#   smtps://USER:PASS@smtp.gmail.com:465   (Gmail with an app password)
#   smtps://resend:API_KEY@smtp.resend.com:465
SMTP_URL=
DIGEST_FROM=Extension Tracker <digest@example.com>
DIGEST_TO=you@example.com

# Public URL of the dashboard, linked from the email
APP_URL=http://localhost:3000

# Country storefront for Safari (App Store) ratings
SAFARI_COUNTRY=us
